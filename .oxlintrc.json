{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off",
    "style": "off"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "no-eval": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-underscore-dangle": ["error", { "allow": ["_meta"] }]
  },
  "overrides": [
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/desktop/src/renderer/**/*.ts"],
      "env": {
        "browser": true
      },
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "dist/**", "apps/desktop/out/**"]
}
