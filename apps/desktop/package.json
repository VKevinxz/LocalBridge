{
  "name": "@localbridge/desktop",
  "version": "1.7.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "VKevinXZ",
  "type": "module",
  "description": "Aplicación de escritorio de LocalBridge MCP para proyectos, permisos y conexión segura",
  "homepage": "https://github.com/VKevinxz/LocalBridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VKevinxz/LocalBridge.git"
  },
  "bugs": {
    "url": "https://github.com/VKevinxz/LocalBridge/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.server.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "vendor:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-desktop-vendor.ps1",
    "package:win:dir": "pnpm vendor:prepare && pnpm build && electron-builder --win --dir --publish never",
    "package:win": "pnpm vendor:prepare && pnpm build && electron-builder --win",
    "package:win:signed": "pnpm vendor:prepare && pnpm build && electron-builder --win --config.forceCodeSigning=true"
  },
  "dependencies": {
    "@localbridge/audit": "workspace:*",
    "@localbridge/desktop-core": "workspace:*",
    "@localbridge/development": "workspace:*",
    "@localbridge/filesystem": "workspace:*",
    "@localbridge/mcp-server": "workspace:^",
    "@localbridge/permissions": "workspace:*",
    "@localbridge/shared": "workspace:*",
    "@localbridge/workspace": "workspace:*",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "@types/pngjs": "6.0.5",
    "electron-vite": "^5.0.0",
    "vite": "^7.1.11"
  }
}
